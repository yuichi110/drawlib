# Ignore everything by default so docs/ and tools/release_assets/ are excluded from build context
*

# Allow only files required for clean-room drawlib build and unit test execution
!pyproject.toml
!src/
!tests/
!docs_src
docs_src/*
!docs_src/README_PYPI.md
!docs_src/api
!docs_src/api/**

# Exclude runtime caches and bytecode inside allowed directories
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
src/drawlib/_cached_assets/*
!src/drawlib/_cached_assets/__init__.py
!src/drawlib/_cached_assets/.gitignore
