/* GitHub Print/PDF Theme for drawlib build pdf */

:root {
    --rtd-code-keyword: #cf222e;
    --rtd-code-string: #0a3069;
    --rtd-code-comment: #6e7781;
    --rtd-code-number: #0550ae;
    --rtd-code-function: #8250df;
    --rtd-code-type: #953800;
    --rtd-code-operator: #24292f;
    --rtd-code-builtin: #0550ae;
}

@page {
    size: A4;
    margin: 18mm 16mm;
}

* {
    box-sizing: border-box;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}

html, body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", __RTD_FONT_FAMILY__system-ui, "Noto Sans", Helvetica, Arial, sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: #1f2328;
    background-color: #ffffff;
    margin: 0;
    padding: 0;
}

hr {
    display: none;
}

h1, h2, h3, h4, h5, h6 {
    color: #1f2328;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
    break-after: avoid;
    page-break-after: avoid;
}

h1 {
    font-size: 1.95rem;
    margin-top: 0;
}

h2 {
    font-size: 1.4rem;
}

code {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, __RTD_MONO_FONT_FAMILY__monospace;
    font-size: 0.85em;
    background-color: rgba(175, 184, 193, 0.2);
    padding: 0.15em 0.35em;
    border-radius: 6px;
}

pre {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 0.95rem 1.1rem;
    font-size: 0.82em;
    line-height: 1.5;
    white-space: pre-wrap !important;
    word-wrap: break-word !important;
    word-break: break-word !important;
    overflow: visible !important;
    break-inside: avoid;
    page-break-inside: avoid;
}

pre code {
    background-color: transparent;
    padding: 0;
    white-space: pre-wrap !important;
}

/* Pygments syntax highlighting tokens */
pre code .k, pre code .kc, pre code .kd, pre code .kn, pre code .kp, pre code .kr, pre code .kt { color: var(--rtd-code-keyword); font-weight: 600; }
pre code .s, pre code .sa, pre code .sb, pre code .sc, pre code .dl, pre code .sd, pre code .s2, pre code .se, pre code .sh, pre code .si, pre code .sx, pre code .sr, pre code .s1, pre code .ss { color: var(--rtd-code-string); }
pre code .c, pre code .ch, pre code .cm, pre code .cp, pre code .cpf, pre code .c1, pre code .cs { color: var(--rtd-code-comment); font-style: italic; }
pre code .m, pre code .mb, pre code .mf, pre code .mh, pre code .mi, pre code .mo, pre code .il { color: var(--rtd-code-number); }
pre code .nf, pre code .fm { color: var(--rtd-code-function); }
pre code .nc, pre code .ne, pre code .nn, pre code .nt { color: var(--rtd-code-type); font-weight: 600; }
pre code .na, pre code .nd, pre code .py { color: var(--rtd-code-type); font-weight: 600; }
pre code .nb, pre code .bp { color: var(--rtd-code-builtin); }
pre code .o, pre code .ow { color: var(--rtd-code-operator); }
pre code .err { color: #ef4444; }

table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.2rem 0;
    font-size: 0.88rem;
    break-inside: avoid;
}

th, td {
    border: 1px solid #d0d7de;
    padding: 0.55rem 0.85rem;
}

th {
    background-color: #f6f8fa;
    font-weight: 600;
}

.drawlib-image {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 1.4rem 0;
    padding: 0.9rem;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    break-inside: avoid;
    page-break-inside: avoid;
}

.drawlib-image img {
    max-width: 100%;
    max-height: 360px;
}

.drawlib-caption {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: #59636e;
}

.drawlib-code-details {
    display: none !important;
}

