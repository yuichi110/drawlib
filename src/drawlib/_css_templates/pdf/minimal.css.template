/* Minimalist Print/PDF Theme for drawlib build pdf */

:root {
    --rtd-code-keyword: #1f2937;
    --rtd-code-string: #2563eb;
    --rtd-code-comment: #6b7280;
    --rtd-code-number: #059669;
    --rtd-code-function: #4b5563;
    --rtd-code-type: #7c3aed;
    --rtd-code-operator: #4b5563;
    --rtd-code-builtin: #2563eb;
}

@page {
    size: A4;
    margin: 20mm 18mm;
}

* {
    box-sizing: border-box;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}

html, body {
    font-family: Georgia, "Times New Roman", __RTD_FONT_FAMILY__serif;
    font-size: 14.5px;
    line-height: 1.7;
    color: #222222;
    background-color: #ffffff;
    margin: 0;
    padding: 0;
}

hr {
    display: none;
}

h1, h2, h3, h4, h5, h6 {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", __RTD_FONT_FAMILY__system-ui, "Noto Sans", Helvetica, Arial, sans-serif;
    color: #111111;
    margin-top: 1.5rem;
    margin-bottom: 0.7rem;
    break-after: avoid;
}

code, pre {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, __RTD_MONO_FONT_FAMILY__monospace;
}

pre {
    background-color: #fafafa;
    border: 1px solid #e5e5e5;
    padding: 0.9rem 1.1rem;
    font-size: 0.82em;
    line-height: 1.5;
    white-space: pre-wrap !important;
    word-break: break-word !important;
    overflow: visible !important;
    break-inside: avoid;
}

pre code {
    background-color: transparent;
    padding: 0;
    white-space: pre-wrap !important;
}

/* Pygments syntax highlighting tokens */
pre code .k, pre code .kc, pre code .kd, pre code .kn, pre code .kp, pre code .kr, pre code .kt { color: var(--rtd-code-keyword); font-weight: 600; }
pre code .s, pre code .sa, pre code .sb, pre code .sc, pre code .dl, pre code .sd, pre code .s2, pre code .se, pre code .sh, pre code .si, pre code .sx, pre code .sr, pre code .s1, pre code .ss { color: var(--rtd-code-string); }
pre code .c, pre code .ch, pre code .cm, pre code .cp, pre code .cpf, pre code .c1, pre code .cs { color: var(--rtd-code-comment); font-style: italic; }
pre code .m, pre code .mb, pre code .mf, pre code .mh, pre code .mi, pre code .mo, pre code .il { color: var(--rtd-code-number); }
pre code .nf, pre code .fm { color: var(--rtd-code-function); }
pre code .nc, pre code .ne, pre code .nn, pre code .nt { color: var(--rtd-code-type); font-weight: 600; }
pre code .na, pre code .nd, pre code .py { color: var(--rtd-code-type); font-weight: 600; }
pre code .nb, pre code .bp { color: var(--rtd-code-builtin); }
pre code .o, pre code .ow { color: var(--rtd-code-operator); }
pre code .err { color: #ef4444; }

.drawlib-image {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 1.4rem 0;
    break-inside: avoid;
}

.drawlib-image img {
    max-width: 100%;
    max-height: 360px;
}

.drawlib-caption {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: #555555;
}

.drawlib-code-details {
    display: none !important;
}

