/* drawlib Modern Developer Dark Theme (default-dark.css)
 * Inspired by VitePress (Vue/Vite) & Tailwind CSS documentation
 */
:root {
    --rtd-sidebar-bg: #090d16;
    --rtd-sidebar-header: #090d16;
    --rtd-sidebar-text: #94a3b8;
    --rtd-sidebar-hover: #1e293b;
    --rtd-sidebar-active: #1e1b4b;
    --rtd-sidebar-active-text: #a5b4fc;
    --rtd-brand-color: #818cf8;
    --rtd-brand-dark: #6366f1;
    --rtd-heading-color: #f1f5f9;
    --rtd-text-color: #e2e8f0;
    --rtd-muted-color: #94a3b8;
    --rtd-bg-color: #090d16;
    --rtd-content-bg: #0f172a;
    --rtd-surface-bg: #1e293b;
    --rtd-border-color: #1e293b;
    --rtd-code-bg: #090d16;
    --rtd-inline-code-bg: #1e1b4b;
    --rtd-inline-code-color: #a5b4fc;
    --rtd-note-bg: #1e1b4b;
    --rtd-note-border: #6366f1;
    --rtd-code-keyword: #818cf8;
    --rtd-code-string: #4ade80;
    --rtd-code-comment: #94a3b8;
    --rtd-code-number: #fbbf24;
    --rtd-code-function: #60a5fa;
    --rtd-code-type: #c084fc;
    --rtd-code-operator: #cbd5e1;
    --rtd-code-builtin: #38bdf8;
    --rtd-font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, __RTD_FONT_FAMILY__system-ui, sans-serif;
    --rtd-mono-font: "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, __RTD_MONO_FONT_FAMILY__monospace;
    --sidebar-width: 280px;
}
