/* drawlib Google Editorial Dark Theme (google-dark.css)
 * Inspired by https://blog.google/ (The Keyword) & Google Material Design Web
 */
:root {
    --rtd-sidebar-bg: #17181b;
    --rtd-sidebar-header: #17181b;
    --rtd-sidebar-text: #bdc1c6;
    --rtd-sidebar-hover: #282a2d;
    --rtd-sidebar-active: #1f304d;
    --rtd-sidebar-active-text: #8ab4f8;
    --rtd-brand-color: #8ab4f8;
    --rtd-brand-dark: #aecbfa;
    --rtd-heading-color: #e8eaed;
    --rtd-text-color: #bdc1c6;
    --rtd-muted-color: #9aa0a6;
    --rtd-bg-color: #202124;
    --rtd-content-bg: #202124;
    --rtd-surface-bg: #282a2d;
    --rtd-border-color: #3c4043;
    --rtd-code-bg: #17181b;
    --rtd-inline-code-bg: #303134;
    --rtd-inline-code-color: #8ab4f8;
    --rtd-note-bg: #282a2d;
    --rtd-note-border: #8ab4f8;
    --rtd-code-keyword: #8ab4f8;
    --rtd-code-string: #81c995;
    --rtd-code-comment: #9aa0a6;
    --rtd-code-number: #fdd663;
    --rtd-code-function: #f28b82;
    --rtd-code-type: #d7aefb;
    --rtd-code-operator: #bdc1c6;
    --rtd-code-builtin: #8ab4f8;
    --rtd-font: "Google Sans", "Product Sans", "Inter", "Roboto", -apple-system, BlinkMacSystemFont, "Segoe UI", __RTD_FONT_FAMILY__system-ui, sans-serif;
    --rtd-body-font: "Roboto", "Google Sans Text", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", __RTD_FONT_FAMILY__system-ui, sans-serif;
    --rtd-mono-font: "Roboto Mono", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, __RTD_MONO_FONT_FAMILY__monospace;
    --sidebar-width: 288px;
}
