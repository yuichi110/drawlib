/* Minimal Editorial Theme (minimal.css) */
:root {
    --rtd-sidebar-bg: #fafafa;
    --rtd-sidebar-header: #ffffff;
    --rtd-sidebar-text: #525252;
    --rtd-sidebar-hover: #f5f5f5;
    --rtd-sidebar-active: #e5e5e5;
    --rtd-brand-color: #262626;
    --rtd-brand-dark: #000000;
    --rtd-text-color: #262626;
    --rtd-bg-color: #ffffff;
    --rtd-content-bg: #ffffff;
    --rtd-border-color: #e5e5e5;
    --rtd-code-bg: #fafafa;
    --rtd-inline-code-bg: #f5f5f5;
    --rtd-inline-code-color: #262626;
    --rtd-note-bg: #fafafa;
    --rtd-note-border: #737373;
    --rtd-code-keyword: #1f2937;
    --rtd-code-string: #2563eb;
    --rtd-code-comment: #6b7280;
    --rtd-code-number: #059669;
    --rtd-code-function: #4b5563;
    --rtd-code-type: #7c3aed;
    --rtd-code-operator: #4b5563;
    --rtd-code-builtin: #2563eb;
    --rtd-font: -apple-system, BlinkMacSystemFont, "Georgia", __RTD_FONT_FAMILY__serif;
    --rtd-mono-font: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, __RTD_MONO_FONT_FAMILY__monospace;
    --sidebar-width: 260px;
}

@media (prefers-color-scheme: dark) {
    :root {
        --rtd-sidebar-bg: #171717;
        --rtd-sidebar-header: #0a0a0a;
        --rtd-sidebar-text: #a3a3a3;
        --rtd-sidebar-hover: #262626;
        --rtd-sidebar-active: #404040;
        --rtd-brand-color: #e5e5e5;
        --rtd-brand-dark: #ffffff;
        --rtd-text-color: #d4d4d4;
        --rtd-bg-color: #0a0a0a;
        --rtd-content-bg: #171717;
        --rtd-border-color: #262626;
        --rtd-code-bg: #0a0a0a;
        --rtd-inline-code-bg: #262626;
        --rtd-inline-code-color: #e5e5e5;
        --rtd-note-bg: #262626;
        --rtd-note-border: #a3a3a3;
        --rtd-code-keyword: #f3f4f6;
        --rtd-code-string: #60a5fa;
        --rtd-code-comment: #9ca3af;
        --rtd-code-number: #34d399;
        --rtd-code-function: #e5e7eb;
        --rtd-code-type: #c084fc;
        --rtd-code-operator: #d1d5db;
        --rtd-code-builtin: #60a5fa;
    }
}
