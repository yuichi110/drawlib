<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Drawlib Document") }}</title>
    {% if css_href %}
    <link rel="stylesheet" href="{{ css_href }}">
    {% else %}
    <style>
:root {
    --rtd-sidebar-bg: #343131;
    --rtd-sidebar-header: #2980b9;
    --rtd-sidebar-text: #b3b3b3;
    --rtd-sidebar-hover: #4e4a4a;
    --rtd-sidebar-active: #242121;
    --rtd-brand-color: #2980b9;
    --rtd-brand-dark: #1b5e8a;
    --rtd-text-color: #404040;
    --rtd-bg-color: #edf0f2;
    --rtd-content-bg: #ffffff;
    --rtd-border-color: #e1e4e5;
    --rtd-code-bg: #f8f8f8;
    --rtd-inline-code-bg: #ecf0f1;
    --rtd-inline-code-color: #e74c3c;
    --rtd-note-bg: #e7f2fa;
    --rtd-note-border: #6ab0de;
    --rtd-font: "Lato", "proxima-nova", "Helvetica Neue", Arial, sans-serif;
    --rtd-mono-font: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    --sidebar-width: 280px;
}

@media (prefers-color-scheme: dark) {
    :root {
        --rtd-sidebar-bg: #1e1e1e;
        --rtd-sidebar-header: #1f618d;
        --rtd-sidebar-text: #a0a0a0;
        --rtd-sidebar-hover: #2d2d2d;
        --rtd-sidebar-active: #141414;
        --rtd-brand-color: #3498db;
        --rtd-text-color: #d1d5db;
        --rtd-bg-color: #121212;
        --rtd-content-bg: #1e1e1e;
        --rtd-border-color: #333333;
        --rtd-code-bg: #262626;
        --rtd-inline-code-bg: #2d3748;
        --rtd-inline-code-color: #f56565;
        --rtd-note-bg: #1a365d;
        --rtd-note-border: #3182ce;
    }
}

* {
    box-sizing: border-box;
}

body {
    font-family: var(--rtd-font);
    font-size: 16px;
    line-height: 1.6;
    color: var(--rtd-text-color);
    background-color: var(--rtd-bg-color);
    margin: 0;
    padding: 0;
}

.doc-layout {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: var(--sidebar-width);
    background-color: var(--rtd-sidebar-bg);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    z-index: 100;
}

.sidebar-header {
    background-color: var(--rtd-sidebar-header);
    padding: 1.25rem 1.5rem;
    text-align: center;
}

.sidebar-brand {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.5px;
    display: block;
}

.sidebar-brand:hover {
    color: #ffffff;
    text-decoration: none;
}

.sidebar-menu {
    padding: 1rem 0;
    overflow-y: auto;
    flex: 1;
}

.sidebar-heading {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0.5rem 1.5rem;
    margin-top: 0.5rem;
}

.nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.nav-item a {
    color: var(--rtd-sidebar-text);
    display: block;
    padding: 0.6rem 1.5rem;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
    border-left: 4px solid transparent;
}

.nav-item a:hover {
    background-color: var(--rtd-sidebar-hover);
    color: #ffffff;
}

.nav-item.active a {
    background-color: var(--rtd-sidebar-active);
    color: #ffffff;
    font-weight: 600;
    border-left-color: var(--rtd-brand-color);
}

.content-wrapper {
    flex: 1;
    background-color: var(--rtd-content-bg);
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.top-bar {
    background-color: var(--rtd-content-bg);
    border-bottom: 1px solid var(--rtd-border-color);
    padding: 0.85rem 2.5rem;
    font-size: 0.9rem;
}

.breadcrumbs {
    color: #999;
}

.crumb {
    color: var(--rtd-brand-color);
}

.crumb.active {
    color: var(--rtd-text-color);
}

.crumb-separator {
    margin: 0 0.4rem;
    color: #ccc;
}

.main-content {
    padding: 2rem 2.5rem 4rem 2.5rem;
    max-width: 960px;
    flex: 1;
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--rtd-font);
    color: #2c3e50;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
}

@media (prefers-color-scheme: dark) {
    h1, h2, h3, h4, h5, h6 {
        color: #e2e8f0;
    }
}

h1 {
    font-size: 2.2rem;
    margin-top: 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--rtd-border-color);
}

h2 {
    font-size: 1.6rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rtd-border-color);
}

h3 {
    font-size: 1.3rem;
}

a {
    color: var(--rtd-brand-color);
    text-decoration: none;
}

a:hover {
    color: var(--rtd-brand-dark);
    text-decoration: underline;
}

code {
    font-family: var(--rtd-mono-font);
    font-size: 0.88em;
    background-color: var(--rtd-inline-code-bg);
    color: var(--rtd-inline-code-color);
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
    border: 1px solid var(--rtd-border-color);
}

pre {
    background-color: var(--rtd-code-bg);
    border: 1px solid var(--rtd-border-color);
    border-radius: 4px;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.9em;
    line-height: 1.45;
}

pre code {
    background-color: transparent;
    color: inherit;
    padding: 0;
    border: none;
}

blockquote {
    margin: 1.5rem 0;
    padding: 0.8rem 1.2rem;
    background-color: var(--rtd-note-bg);
    border-left: 4px solid var(--rtd-note-border);
    color: var(--rtd-text-color);
    border-radius: 0 4px 4px 0;
}

blockquote p {
    margin: 0;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
}

th, td {
    border: 1px solid var(--rtd-border-color);
    padding: 0.65rem 0.9rem;
    text-align: left;
}

th {
    background-color: var(--rtd-brand-color);
    color: #ffffff;
    font-weight: 600;
}

tr:nth-child(even) {
    background-color: rgba(0, 0, 0, 0.02);
}

.drawlib-image {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 2rem 0;
    padding: 1rem;
    background-color: #ffffff;
    border: 1px solid var(--rtd-border-color);
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

@media (prefers-color-scheme: dark) {
    .drawlib-image {
        background-color: #262626;
    }
}

.drawlib-image img, .drawlib-image svg {
    max-width: 100%;
    height: auto;
}

.footer {
    border-top: 1px solid var(--rtd-border-color);
    padding: 1.5rem 2.5rem;
    font-size: 0.85rem;
    color: #888;
}

@media (max-width: 768px) {
    .doc-layout {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
    }

    .main-content {
        padding: 1.5rem;
    }
}
    </style>
    {% if custom_css %}
    <style>
        {{ custom_css | safe }}
    </style>
    {% endif %}
    {% endif %}
</head>
<body>
    {% if nav_items and nav_items | length > 0 %}
    <div class="doc-layout">
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="index.html" class="sidebar-brand">drawlib</a>
            </div>
            <div class="sidebar-menu">
                <div class="sidebar-heading">Navigation</div>
                <ul class="nav-list">
                    {% for item in nav_items %}
                    <li class="nav-item {% if item.active %}active{% endif %}">
                        <a href="{{ item.url }}">{{ item.title }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </aside>
        <div class="content-wrapper">
            <header class="top-bar">
                <div class="breadcrumbs">
                    <span class="crumb">Docs</span>
                    <span class="crumb-separator">&raquo;</span>
                    <span class="crumb active">{{ title }}</span>
                </div>
            </header>
            <main class="main-content">
                {{ body | safe }}
            </main>
        </div>
    </div>
    {% else %}
    <div class="main-content" style="margin: 0 auto;">
        {{ body | safe }}
    </div>
    {% endif %}
</body>
</html>
