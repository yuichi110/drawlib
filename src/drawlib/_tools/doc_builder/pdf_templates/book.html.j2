<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Drawlib Document") }}</title>
    {% if css_href %}
    <link rel="stylesheet" href="{{ css_href }}">
    {% endif %}
    {% if custom_css %}
    <style>
{{ custom_css | safe }}
    </style>
    {% endif %}
</head>
<body class="pdf-body pdf-book">
    <article class="pdf-document">
        {{ body | safe }}
    </article>
</body>
</html>
