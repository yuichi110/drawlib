ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

ARG INSTALL_SOURCE=local
ARG DRAWLIB_VERSION=""
ARG WITH_PDF=false
ARG WITH_ASSETS=false

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# Install system dependencies for matplotlib and create non-root runtime user
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /bin/bash drawlib \
    && mkdir -p /workspace /opt/ms-playwright

WORKDIR /tmp/drawlib_build
COPY pyproject.toml ./
COPY src/ ./src/

# Install drawlib (from local source or PyPI)
RUN mkdir -p docs_src && touch docs_src/README_PYPI.md && \
    if [ "${INSTALL_SOURCE}" = "pypi" ]; then \
        pip install --no-cache-dir "drawlib==${DRAWLIB_VERSION}"; \
    else \
        pip install --no-cache-dir "."; \
    fi && rm -rf /tmp/drawlib_build

# Optional: Install Playwright headless Chromium and OS dependencies for PDF generation
RUN if [ "${WITH_PDF}" = "true" ]; then \
        playwright install --with-deps --only-shell chromium && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Optional: Pre-download all font and icon assets for air-gapped / offline usage
RUN if [ "${WITH_ASSETS}" = "true" ]; then \
        drawlib cache download --all; \
    fi && \
    python -c "import pathlib, drawlib._cached_assets as c; p = pathlib.Path(c.__file__).parent; p.mkdir(parents=True, exist_ok=True)" && \
    chown -R drawlib:drawlib /workspace /opt/ms-playwright "$(python -c 'import pathlib, drawlib._cached_assets as c; print(pathlib.Path(c.__file__).parent)')"

WORKDIR /workspace
USER drawlib
CMD ["drawlib", "--help"]

