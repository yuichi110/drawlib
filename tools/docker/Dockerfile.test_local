ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies for matplotlib
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install test runner dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-cov \
    pytest-xdist

# Copy and install local drawlib package
COPY pyproject.toml README_PYPI.md LICENSE.txt ./
COPY src/ ./src/
RUN pip install --no-cache-dir . && rm -rf ./src pyproject.toml README_PYPI.md LICENSE.txt

# Copy test suite and assets
COPY tests/ ./tests/
RUN mkdir -p output_tests

CMD ["pytest", "-n", "auto", "tests/drawlib/"]
