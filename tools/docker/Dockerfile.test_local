ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies for matplotlib
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install test runner dependencies and baseline rendering libraries matching test answer images
RUN pip install --no-cache-dir \
    pytest \
    pytest-cov \
    pytest-xdist \
    matplotlib==3.10.9 \
    pillow==12.2.0

# Copy and install local drawlib package (including [pdf] extras for unit test mocks)
COPY pyproject.toml ./
COPY src/ ./src/
RUN touch README_PYPI.md && pip install --no-cache-dir ".[pdf]" && rm -rf ./src README_PYPI.md

# Copy test suite and assets
COPY tests/ ./tests/
RUN mkdir -p output_tests

CMD ["sh", "-c", "drawlib cache download --all && pytest -n auto --dist loadfile tests/drawlib/"]
